<music root="music/P5R/">
	<!-- Track names must be "P5R <Track Type>" to match AddSoundtrackToMenu("P5R") in main.lua. No id attributes. -->
	<!-- Any track type not listed here falls back to the game's default audio. -->
	<!-- mul= is a volume multiplier. The P5R masters sit around -9 LUFS, louder than Isaac music, so the menu tracks are pulled down; the tainted run-start opening is a quiet guitar riff (-15.6 LUFS) so it is pushed up. Adjust after in-game testing. -->
	<!-- All files are OGG Vorbis, constant 192 kbps, 44.1 kHz. Intro and loop files must keep the same bitrate. -->

	<!-- Main menu: Beneath the Mask (instrumental). Tainted menu plays Life Will Change on its own (layermode 2). -->
	<track name="P5R Main Menu" intro="main_menu_intro.ogg" path="main_menu.ogg" layerintro="tainted_menu_intro.ogg" layer="tainted_menu.ogg" loop="true" layermode="2" layerfadespeed="0.01" mul="0.8" />

	<!-- Run start jingles (Repentogon only): opening bars of Last Surprise and Life Will Change. -->
	<track name="P5R Run Start" path="run_start.ogg" loop="false" mul="0.8" />
	<track name="P5R Tainted Run Start" path="tainted_run_start.ogg" loop="false" mul="1.4" />
</music>
